{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsa.gov/oscal-vault/assessment/gsa-test-cases-v1.json",
  "title": "GSA NIST SP 800-53A test cases, canonical JSON",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "version", "source_document", "authority", "poc_email", "categorization_level", "notes", "total_controls_in_scope", "total_test_cases", "summary", "test_cases"],
  "$defs": {
    "controlId": {"type": "string", "pattern": "^([A-Z]{2}-[0-9]+(\\([0-9A-Z]+\\))?|BOD [0-9]+-[0-9]+)$"}
  },
  "properties": {
    "kind": {"const": "gsa-lato-low-test-cases"},
    "title": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "source_document": {"type": "string"},
    "authority": {"type": "string"},
    "poc_email": {"const": "<POC_EMAIL>"},
    "categorization_level": {"enum": ["Low", "Moderate", "High"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "total_controls_in_scope": {"type": "integer", "minimum": 0},
    "total_test_cases": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "control_id", "raw_control_id", "name", "assessment_result", "expected_test_cases"],
        "properties": {
          "family": {"type": "string"},
          "control_id": {"$ref": "#/$defs/controlId"},
          "raw_control_id": {"type": "string"},
          "name": {"type": "string"},
          "assessment_result": {"type": "string"},
          "expected_test_cases": {"type": "integer", "minimum": 0}
        }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "control_id", "raw_control_id", "control_name", "procedure_id", "objective", "examine", "interview", "test", "observations_and_evidence", "assessment_result", "recommendation_for_mitigation"],
        "properties": {
          "family": {"type": "string"},
          "control_id": {"$ref": "#/$defs/controlId"},
          "raw_control_id": {"type": "string"},
          "control_name": {"type": "string"},
          "procedure_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string"},
          "examine": {"type": "string"},
          "interview": {"type": "string"},
          "test": {"type": "string"},
          "observations_and_evidence": {"type": "string"},
          "assessment_result": {"type": "string"},
          "recommendation_for_mitigation": {"type": "string"}
        }
      }
    }
  }
}
