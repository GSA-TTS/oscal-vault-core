{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsa.gov/oscal-vault/decision/control-grade-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "control_id", "method", "grade", "confidence", "summary", "strengths", "missing_prerequisites", "recommended_actions", "citations", "human_review"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string"},
    "control_id": {"type": "string"},
    "method": {"enum": ["deterministic_preflight", "llm_assisted"]},
    "grade": {"enum": ["complete", "substantially_complete", "partial", "insufficient", "not_applicable_claim", "review_required"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string"},
    "strengths": {"type": "array", "items": {"type": "string"}},
    "missing_prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prerequisite_id", "description", "severity", "citations"],
        "properties": {
          "prerequisite_id": {"type": "string"},
          "description": {"type": "string"},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "citations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommended_actions": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "string"}},
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "reviewer", "decision_ref"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "pending"},
        "reviewer": {"type": ["string", "null"]},
        "decision_ref": {"type": ["string", "null"]}
      }
    }
  }
}
