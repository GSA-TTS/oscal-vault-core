{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsa.gov/oscal-vault/decision/d3fend-nist-mapping-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "source_sha256", "mappings"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["d3fend_id", "name", "nist_controls", "description"],
        "properties": {
          "d3fend_id": {"type": "string"},
          "name": {"type": "string"},
          "nist_controls": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "description": {"type": "string"},
          "source_uri": {"type": ["string", "null"]}
        }
      }
    }
  }
}
