{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gsa.gov/oscal-vault/oscal-lineage-v1.json",
  "title": "OSCAL Vault Lineage Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "counters", "derivations"],
  "properties": {
    "schema_version": {"const": 1},
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "extension_bridge", "preserved_only", "active_mappings", "covered_active_mappings"],
      "properties": {
        "native": {"type": "integer", "minimum": 0},
        "extension_bridge": {"type": "integer", "minimum": 0},
        "preserved_only": {"type": "integer", "minimum": 0},
        "active_mappings": {"type": "integer", "minimum": 0},
        "covered_active_mappings": {"type": "integer", "minimum": 0}
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["derivation_id", "derivation_kind", "mapping_source", "adapter", "export_class", "cardinality", "source_ids", "canonical_pointers", "oscal_pointers", "allowed_operators"],
        "properties": {
          "derivation_id": {"type": "string", "minLength": 1},
          "derivation_kind": {"enum": ["mapping", "fan_out", "aggregation"]},
          "mapping_source": {"type": "string", "minLength": 1},
          "adapter": {"type": ["string", "null"]},
          "export_class": {"enum": ["native", "extension_bridge", "preserved_only"]},
          "cardinality": {"enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "canonical_pointers": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
          "oscal_pointers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allowed_operators": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "runtime_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "extension_bridge", "preserved_only"],
      "properties": {
        "native": {"type": "integer", "minimum": 0},
        "extension_bridge": {"type": "integer", "minimum": 0},
        "preserved_only": {"type": "integer", "minimum": 0}
      }
    },
    "runtime_derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["derivation_id", "mapping_source", "source_ids", "canonical_pointers", "oscal_pointers", "events", "preserved_extensions"],
        "properties": {
          "derivation_id": {"type": "string"},
          "mapping_source": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "canonical_pointers": {"type": "array", "items": {"type": "string"}},
          "oscal_pointers": {"type": "array", "items": {"type": "string"}},
          "events": {"type": "array", "items": {"$ref": "#/$defs/transformEvent"}},
          "preserved_extensions": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "runtime_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/transformEvent"}
    },
    "preserved_extensions": {
      "type": "array",
      "items": {"type": "object"}
    },
    "component_value_lineage": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "transformEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "input_sha256", "output_sha256", "changed", "lossiness", "consumed", "residual", "warnings"],
      "properties": {
        "operator": {"type": "string"},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "changed": {"type": "boolean"},
        "lossiness": {"enum": ["none", "structural", "provenance_only", "partial"]},
        "consumed": {"type": "array", "items": {"type": "string"}},
        "residual": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
