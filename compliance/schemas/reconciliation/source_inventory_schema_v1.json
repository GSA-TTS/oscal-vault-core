{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsa.gov/oscal-vault/reconciliation/source-inventory-v1.json",
  "title": "Automation source inventory configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_id", "repository", "technologies", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "system_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repository": {"type": "string", "minLength": 1},
    "technologies": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "include", "kind"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "include": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "extract_control_ids": {"type": "boolean", "default": false}
        }
      }
    }
  }
}
