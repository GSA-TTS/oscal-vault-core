{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsa.gov/oscal-vault/reconciliation/overlay-v1.json",
  "title": "SSP reconciliation overlay",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "system_id", "baseline", "automation_source", "authority", "changes"],
  "properties": {
    "schema_version": {"const": 1},
    "system_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "automation_source": {
      "type": "object",
      "required": ["repository", "commit", "inventory_sha256"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "baseline": {"type": "object"},
    "authority": {"type": "object"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation_id", "operation", "target_type", "target_id", "field", "status", "source_evidence", "rationale", "review"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "operation": {"enum": ["add", "replace", "append", "remove", "retain", "assert_unchanged"]},
          "target_type": {"type": "string", "pattern": "^(oscal|oscal\\.x|okf)\\."},
          "target_id": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "approved", "rejected"]},
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "kind"],
              "properties": {
                "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "kind": {"type": "string"}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 1},
          "review": {
            "type": "object",
            "required": ["required"],
            "properties": {
              "required": {"const": true},
              "reviewer_role": {"type": ["string", "null"]},
              "decision_ref": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
